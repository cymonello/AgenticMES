digraph {
  compound=true;
  node [shape=Mrecord]
  rankdir="TB"

  Idle [label="Idle"];
  Running [label="Running"];
  Faulted [label="Faulted"];
  Maintenance [label="Maintenance"];
  Setup [label="Setup"];

  Idle -> Running [style="solid", label="Start"];
  Idle -> Setup [style="solid", label="EnterSetup"];
  Idle -> Maintenance [style="solid", label="EnterMaintenance"];
  Idle -> Faulted [style="solid", label="Fault"];

  Running -> Idle [style="solid", label="Stop"];
  Running -> Faulted [style="solid", label="Fault"];
  Running -> Maintenance [style="solid", label="EnterMaintenance"];
  Running -> Setup [style="solid", label="EnterSetup"];

  Faulted -> Idle [style="solid", label="Reset"];
  Faulted -> Maintenance [style="solid", label="EnterMaintenance"];

  Maintenance -> Idle [style="solid", label="Reset"];

  Setup -> Idle [style="solid", label="Reset"];
  Setup -> Running [style="solid", label="CompleteSetup"];
  Setup -> Faulted [style="solid", label="Fault"];
}
